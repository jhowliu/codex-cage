{
  "name": "codex-cage",
  "version": "0.1.0",
  "description": "Run Codex in an isolated Docker workspace and publish verified PRs from issue links.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codex-cage": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs",
    "docker/base"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "qa": "npm run build && node --test \"dist/test/qa.test.js\"",
    "qa:image": "docker build --build-arg CODEX_CLI_VERSION=0.125.0 -t codex-cage/base:local docker/base && docker run --rm codex-cage/base:local sh -lc 'test \"$(id -un)\" = agent && node --version && npm --version && git --version && gh --version && codex --version && curl --version >/dev/null && jq --version && ssh -V'",
    "lint": "npm run typecheck",
    "format": "prettier --check ."
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.12.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.1.5"
  }
}
